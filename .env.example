# Port on which the Express server will run
PORT=3000

# Choose active database engine: 'sqlite' or 'postgres'
DB_TYPE=postgres

# Database connection URL (used for Postgres)
# Use 'localhost' if running the app locally on your host machine connecting to Docker Postgres:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/taskdb

# Use 'db' (the service name defined in docker-compose.yml) if running the app inside Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/taskdb
